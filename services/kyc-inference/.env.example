# ============================================================================
# Configuration du microservice KYC Inference — copier en `.env` (NE PAS committer)
# ============================================================================

# --- OBLIGATOIRE : secret HMAC partagé avec le backend Convex ---------------
# Doit être identique à la valeur configurée côté Convex. Générer p.ex. :
#   openssl rand -hex 32
KYC_INFERENCE_SECRET=

# --- Auth / anti-rejeu -------------------------------------------------------
# Fenêtre de tolérance sur X-Timestamp, en secondes (défaut 300 = 5 min).
KYC_TIMESTAMP_TOLERANCE_SECONDS=300

# --- Récupération des images signées Convex ---------------------------------
KYC_FETCH_TIMEOUT_SECONDS=15
KYC_MAX_DOWNLOAD_BYTES=26214400   # 25 Mo
# Garde SSRF : suffixes d'hôtes autorisés, séparés par des virgules.
# Laisser vide pour autoriser tous les hôtes (déconseillé en prod).
# Exemple : .convex.cloud,.convex.site
ALLOWED_ASSET_HOST_SUFFIXES=

# --- Fichiers temporaires (vidéos liveness) ---------------------------------
KYC_TMP_DIR=/tmp/kyc-inference

# --- OCR (PaddleOCR) ---------------------------------------------------------
KYC_PADDLE_USE_GPU=false
KYC_PADDLE_LANG=fr

# --- Face match (InsightFace) ------------------------------------------------
KYC_INSIGHTFACE_PACK=buffalo_l
KYC_INSIGHTFACE_ROOT=~/.insightface
# Seuil de similarité cosinus "même personne" — À CALIBRER sur données GA.
KYC_FACE_MATCH_THRESHOLD=0.28

# --- Liveness / anti-spoof (MiniFASNet) -------------------------------------
KYC_ANTISPOOF_MODEL_DIR=./models/anti_spoof
# Détecteur de visage caffe (Widerface-RetinaFace) utilisé par MiniFASNet.
KYC_ANTISPOOF_DETECTION_DIR=./models/detection
KYC_LIVENESS_SAMPLE_FRAMES=8
# Seuils de décision sur le score "real" agrégé — À CALIBRER.
KYC_LIVENESS_REAL_THRESHOLD=0.75
KYC_LIVENESS_SPOOF_THRESHOLD=0.40
